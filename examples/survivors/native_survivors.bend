def player(character: U32,x: F32,y: F32,flash: Bool,tail: List<&2,D.Rect>) -> List<&2,D.Rect>:
  match character:
    case 0: hero_0(x,y,flash,tail)
    case 1: hero_1(x,y,flash,tail)
    case 2: hero_2(x,y,flash,tail)
    case 3: hero_3(x,y,flash,tail)
    case 4: hero_4(x,y,flash,tail)
    case 5: hero_5(x,y,flash,tail)
    case 6: hero_6(x,y,flash,tail)
    case 7: hero_7(x,y,flash,tail)
    case _: hero_0(x,y,flash,tail)
