---
import template from '../../../index.html?raw';
import { initialTabScript, activeTabScript } from '../../../entry-scripts.mts';
import { withPageMetadata } from '../../../seo.mts';
import { renderExpeditionAction } from '../../../expedition-menu.mts';
import { MENU_TABS, renderMenuContent } from '../../../menu-content.mts';
import { freshProfile, validateSetup } from '../../../progression.mts';

// Astro owns static presentation. The profile and catalog come from Bend.
const profile = freshProfile();
const initial = { profile, ...validateSetup(profile, {}) };
// A query string cannot select an Astro static build. Ship each menu view and
// select it synchronously in the head, before CSS or asynchronous module loading.
const routeScript = initialTabScript(MENU_TABS);
const routeStyles = `<style>[data-initial-tab]{display:none}${MENU_TABS.map(tab => `html[data-menu-tab="${tab}"] [data-initial-tab="${tab}"]{display:block}`).join('')}html:not([data-menu-tab="expedition"]) #menuDock{display:none}</style>`;
const initialViews = MENU_TABS.map(tab => `<section data-initial-tab="${tab}">${renderMenuContent(tab, { ...initial, staticPickers: true })}</section>`).join('');
const html = withPageMetadata(template, 'home')
  .replace('<html lang="en">', '<html lang="en" data-menu-tab="expedition">')
  .replace('<head>', `<head>${routeScript}${routeStyles}`)
  .replace('data-tab="expedition" class="active"', 'data-tab="expedition"')
  .replace('</nav>', `</nav>${activeTabScript}`)
  .replace('<div id="menuContent"></div>', `<div id="menuContent">${initialViews}</div>`)
  .replace('<div id="menuDock" class="expedition" hidden></div>', `<div id="menuDock" class="expedition">${renderExpeditionAction(initial)}</div>`)
  .replace('<div id="wallet"></div>', '<div id="wallet">◈ 0 · legacy gold</div>');
---
<Fragment set:html={html} />
